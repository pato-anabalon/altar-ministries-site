# Resend (contact + newsletter forms). Without these, forms are simulated in development and answer 503 in production.
RESEND_API_KEY=
# Verified sender on the altar.org.nz domain, e.g. "Altar Ministries <website@altar.org.nz>"
CONTACT_FROM_EMAIL=
# Where contact messages (and newsletter sign-ups without segments) are delivered (temporary until confirmed)
CONTACT_TO_EMAIL=contact@altar.org.nz
# Optional: Resend segment IDs, one per newsletter language
RESEND_NEWSLETTER_SEGMENT_EN=
RESEND_NEWSLETTER_SEGMENT_ES=
